{
  "name": "smart-clerk-typescript",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "create-env": "cross-env NODE_ENV=development && ts-node src/utils/getEnv.ts",
    "start:prod": "npm run build && node dist/index.js",
    "start:test": "npm run build && cross-env NODE_ENV=production node dist/src/index.js",
    "build": "rimraf dist && tsc",
    "build:fast": "esbuild src/index.ts --bundle --minify --platform=node --packages=external --outfile=dist/index.js",
    "start:dev": "cross-env NODE_ENV=development nodemon",
    "pmreload": "npm run build && pm2 reload",
    "migrate": "cross-env NODE_ENV=development knex migrate:latest --knexfile src/knexfile.ts",
    "seed": "knex seed:run --knexfile src/knexfile.ts",
    "make:seeder": "knex seed:make --knexfile src/knexfile.ts",
    "migrate:test": "cross-env NODE_ENV=test knex migrate:latest --knexfile src/knexfile.ts",
    "make:migration": "cross-env NODE_ENV=development knex migrate:make --knexfile src/knexfile.ts",
    "rollback": "cross-env NODE_ENV=development knex migrate:rollback --knexfile src/knexfile.ts",
    "rollback:test": "cross-env NODE_ENV=test knex migrate:rollback --knexfile src/knexfile.ts",
    "test": "cross-env NODE_ENV=test mocha -t 10000 --exit --recursive --require ts-node/register test/**/*.ts",
    "test:single": " cross-env NODE_ENV=test mocha -t 10000 --exit --recursive --require ts-node/register",
    "test:coverage": "cross-env NODE_ENV=test nyc  npm run test",
    "eslint:fix": "eslint --fix .",
    "stop": "pm2 stop",
    "stopall": "pm2 stop all",
    "scale": "pm2 scale",
    "pmlist": "pm2 ls",
    "pmkill": "pm2 kill",
    "pmlog": "pm2 logs",
    "pmlogflush": "pm2 flush",
    "pmdelete": "pm2 delete"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.{md,yml,yml,json}": [
      "prettier --write",
      "git add"
    ]
  },
  "dependencies": {
    "@babel/register": "^7.17.7",
    "@google/genai": "^2.9.0",
    "@hapi/boom": "^9.1.4",
    "@joi/date": "^2.1.0",
    "@notionhq/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "chai": "^4.3.6",
    "change-case-object": "^2.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "formidable": "^2.0.1",
    "helmet": "^5.0.2",
    "http-status-codes": "^2.2.0",
    "joi": "^17.6.0",
    "jsonwebtoken": "^8.5.1",
    "knex": "^3.0.1",
    "lodash": "^4.17.21",
    "mime-types": "^2.1.35",
    "mkdirp": "^1.0.4",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mv": "^2.1.1",
    "node-cron": "^4.5.0",
    "nodemailer": "^6.9.7",
    "openai": "^6.45.0",
    "pg": "^8.7.3",
    "pm2": "^5.2.0",
    "serve-favicon": "^2.5.0",
    "supertest": "^6.2.2",
    "ts-node": "^10.7.0",
    "typescript": "^4.7.4",
    "winston": "^3.7.2",
    "winston-daily-rotate-file": "^4.6.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/boom": "^7.3.1",
    "@types/chai": "^4.3.0",
    "@types/change-case-object": "^2.0.0",
    "@types/compression": "^1.7.2",
    "@types/cookie-parser": "^1.4.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/formidable": "^2.0.4",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/lodash": "^4.14.181",
    "@types/mime-types": "^2.1.1",
    "@types/mkdirp": "^1.0.2",
    "@types/mocha": "^9.1.1",
    "@types/morgan": "^1.9.3",
    "@types/mv": "^2.1.2",
    "@types/node": "^17.0.23",
    "@types/nodemailer": "^6.4.4",
    "@types/pg": "^8.6.5",
    "@types/serve-favicon": "^2.5.3",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.19.0",
    "@typescript-eslint/parser": "^5.19.0",
    "chai": "^4.3.4",
    "codecov": "^3.8.3",
    "cross-env": "^7.0.3",
    "esbuild": "^0.19.5",
    "eslint": "^8.13.0",
    "eslint-config-prettier": "^7.2.0",
    "eslint-plugin-prettier": "^3.4.1",
    "husky": "^4.3.8",
    "lint-staged": "^10.5.4",
    "mocha": "^10.0.0",
    "nodemon": "^2.0.15",
    "nyc": "^15.1.0",
    "prettier": "^2.4.1",
    "rimraf": "^3.0.2",
    "supertest": "^6.1.6"
  }
}
