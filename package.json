{
  "name": "convert-boilerplate-to-ts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "npm run build && cross-env NODE_ENV=production pm2 start dist/index.js --name typescript boilerplate",
    "start:dev": "cross-env NODE_ENV=development nodemon",
    "migrate": "cross-env NODE_ENV=development knex migrate:latest --knexfile src/knexfile.ts",
    "make:migration": "cross-env NODE_ENV=development knex migrate:make --knexfile src/knexfile.ts",
    "rollback": "cross-env NODE_ENV=development knex migrate:rollback --knexfile src/knexfile.ts",
    "test": "cross-env NODE_ENV=test mocha -t 10000 --exit --recursive --require ts-node/register test/**/*.ts",
    "test:coverage": "cross-env NODE_ENV=test nyc  npm run test",
    "eslint:fix": "eslint --fix .",
    "stop": "pm2 stop",
    "stopall": "pm2 stop all",
    "scale": "pm2 scale",
    "pmlist": "pm2 ls",
    "pmreload": "npm run build && pm2 reload",
    "pmkill": "pm2 kill",
    "pmlog": "pm2 logs",
    "pmlogflush": "pm2 flush",
    "pmdelete": "pm2 delete"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.{md,yml,yml,json}": [
      "prettier --write",
      "git add"
    ]
  },
  "dependencies": {
    "@hapi/boom": "^9.1.4",
    "bcrypt": "^5.0.1",
    "bookshelf": "^1.2.0",
    "bookshelf-virtuals-plugin": "^1.0.0",
    "chai": "^4.3.6",
    "change-case-object": "^2.0.0",
    "codecov": "^3.8.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "formidable": "^2.0.1",
    "helmet": "^5.0.2",
    "http-status-codes": "^2.2.0",
    "joi": "^17.6.0",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.21",
    "mime-types": "^2.1.35",
    "mkdirp": "^1.0.4",
    "mocha": "^9.2.2",
    "morgan": "^1.10.0",
    "mv": "^2.1.1",
    "nodemailer": "^6.7.3",
    "pg": "^8.7.3",
    "pm2": "^5.2.0",
    "rimraf": "^3.0.2",
    "serve-favicon": "^2.5.0",
    "supertest": "^6.2.2",
    "swagger-jsdoc": "^6.2.0",
    "swagger-ui-dist": "^4.10.3",
    "ts-node": "^10.7.0",
    "typescript": "^4.9.3",
    "winston": "^3.7.2",
    "winston-daily-rotate-file": "^4.6.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/bookshelf": "^1.2.7",
    "@types/boom": "^7.3.1",
    "@types/chai": "^4.3.0",
    "@types/change-case-object": "^2.0.0",
    "@types/compression": "^1.7.2",
    "@types/cookie-parser": "^1.4.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/formidable": "^2.0.4",
    "@types/http-status-codes": "^1.2.0",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/lodash": "^4.14.181",
    "@types/mime-types": "^2.1.1",
    "@types/mkdirp": "^1.0.2",
    "@types/mocha": "^9.1.1",
    "@types/morgan": "^1.9.3",
    "@types/mv": "^2.1.2",
    "@types/node": "^17.0.23",
    "@types/nodemailer": "^6.4.4",
    "@types/pg": "^8.6.5",
    "@types/serve-favicon": "^2.5.3",
    "@types/supertest": "^2.0.12",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-dist": "^3.30.1",
    "@typescript-eslint/eslint-plugin": "^5.19.0",
    "@typescript-eslint/parser": "^5.19.0",
    "eslint": "^8.13.0",
    "eslint-config-prettier": "^7.2.0",
    "eslint-plugin-prettier": "^3.4.1",
    "husky": "^4.3.8",
    "lint-staged": "^10.5.4",
